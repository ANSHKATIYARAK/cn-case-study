{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "css/style.css", "use": "@vercel/static" },
    { "src": "js/app.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/css/style.css", "dest": "/css/style.css" },
    { "src": "/js/app.js", "dest": "/js/app.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
